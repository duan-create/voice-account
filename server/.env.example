# Copy to .env if you need to change these defaults.
# Use multilingual models (base, small, etc.), NOT base.en.
# A prepared CTranslate2 model directory is also accepted, e.g. models/base-local.
WHISPER_MODEL=base

# First run: 0 downloads missing model files into server/models.
# After preparation: 1 refuses downloads and requires locally cached files.
WHISPER_LOCAL_FILES_ONLY=0

# Host is always 127.0.0.1; it is intentionally not configurable.
ASR_PORT=5000

# Comma-separated exact local browser origins; no wildcard or remote origins.
ASR_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:8000,http://127.0.0.1:8000,http://localhost:8100,http://127.0.0.1:8100,http://localhost:5173,http://127.0.0.1:5173
